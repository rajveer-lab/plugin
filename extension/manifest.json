{
  "manifest_version": 3,
  "name": "Hallucination Guard",
  "version": "0.1.0",
  "description": "Flags unsupported claims and fake links in ChatGPT, Claude and Gemini answers, checked against sources on your device.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "scripting", "offscreen"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://*.wikipedia.org/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Hallucination Guard",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
      "js": [
        "engine/grounder.js",
        "content/sites/chatgpt.js",
        "content/sites/claude.js",
        "content/sites/gemini.js",
        "content/overlay.js",
        "content/main.js"
      ],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
